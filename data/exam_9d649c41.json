          "id": "p2_q1"
        },
        {
          "text": "Bác An mang 500000 đồng ra chợ mua 5 kg gạo tẻ giá 15000 đồng/kg, 2 kg thịt bò giá 180000 đồng/kg và dùng số tiền còn lại mua rau củ. Xét tính đúng sai của các mệnh đề sau:",
          "items": {
            "a": {
              "text": "Tổng số tiền bác An mua gạo và thịt bò là 425000 đồng.",
              "answer": false
            },
            "b": {
              "text": "Số tiền bác An còn lại để mua rau củ là 75000 đồng.",
              "answer": false
            },
            "c": {
              "text": "Số tiền bác An mua gạo tẻ là 75000 đồng.",
              "answer": true
            },
            "d": {
              "text": "Số tiền bác An mua thịt bò là 360000 đồng.",
              "answer": true
            }
          },
          "id": "p2_q2"
        },
        {
          "text": "Cho các bài toán tìm số tự nhiên  $x$ . Xét tính đúng sai của các mệnh đề sau:",
          "items": {
            "a": {
              "text": "Nếu  $4x-12=20$  thì  $x=2$ .",
              "answer": false
            },
            "b": {
              "text": "Nếu  $x+25=60$  thì  $x=35$ .",
              "answer": true
            },
            "c": {
              "text": "Nếu  $2^{x}=16$  thì suy ra  $x=4$ .",
              "answer": true
            },
            "d": {
              "text": "Nếu  $(x-5)\\cdot 3=18$  thì  $x=10$ .",
              "answer": false
            }
          },
          "id": "p2_q3"
        },
        {
          "text": "Cho tập hợp  $X=\\left\\{ x\\in \\mathbb{N}\\mid 10\\le x<15 \\right\\}$  và tập hợp  $Y=\\left\\{ 10;11;12;13;14;15 \\right\\}$ . Xét tính đúng sai của các mệnh đề sau:",
          "items": {
            "a": {
              "text": "Tập hợp  $X$  được viết dưới dạng liệt kê phần tử là  $X=\\left\\{ 10;11;12;13;14 \\right\\}$ .",
              "answer": true
            },
            "b": {
              "text": "Số phần tử của tập hợp  $X$  là 6 phần tử.",
              "answer": false
            },
            "c": {
              "text": "Phần tử 15 thuộc tập hợp  $X$ .",
              "answer": false
            },
            "d": {
              "text": "Tập hợp  $X$  và tập hợp  $Y$  không bằng nhau.",
              "answer": true
            }
          },
          "id": "p2_q4"
        }
      ]
