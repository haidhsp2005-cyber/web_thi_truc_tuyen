          "answer": "B",
          "explanation": "",
          "id": "p1_q7"
        },
        {
          "text": "Kết quả của phép tính  $5^{6}:5^{2}$  là:",
          "options": {
            "A": "$5^{3}$",
            "B": "$5^{8}$",
            "C": "$1^{4}$",
            "D": "$5^{4}$"
